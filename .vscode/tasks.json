{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: Windows",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "build/windows",
                "--config",
                "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Build the project for Windows. (Default)"
        },
        {
            "label": "Build: Android",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "build/android"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Build the project for Android."
        },
        {
            "label": "Configure: Windows",
            "type": "process",
            "command": "cmake",
            "args": [
                "-B",
                "build/windows",
                "."
            ],
            "detail": "Configure the project for Windows."
        },
        {
            "label": "Configure: Android",
            "type": "process",
            "command": "cmake",
            "args": [
                "-B",
                "build/android",
                "-G",
                "Ninja",
                "-DCMAKE_TOOLCHAIN_FILE=${env:ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "-DANDROID_ABI=arm64-v8a",
                "-DANDROID_PLATFORM=android-33",
                "-DCMAKE_BUILD_TYPE=Release",
                "."
            ],
            "detail": "Configure the project for Android."
        }
    ]
}